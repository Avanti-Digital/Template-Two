---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image = '/og.png' } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const ogImage = Astro.site ? new URL(image, Astro.site) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F3F0E9" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        try {
          const raw = localStorage.getItem('northline-studio-theme');
          if (!raw) return;
          const saved = JSON.parse(raw);
          const names = ['Warm Gallery', 'Ink & Paper', 'Ultramarine', 'Clay', 'Moss'];
          const keys = ['--color-canvas', '--color-surface', '--color-ink', '--color-muted', '--color-accent', '--color-line'];
          if (!saved || !names.includes(saved.name) || typeof saved.values !== 'object') return;
          if (!keys.every((key) => /^#[0-9a-fA-F]{6}$/.test(saved.values[key] || ''))) return;
          keys.forEach((key) => document.documentElement.style.setProperty(key, saved.values[key]));
          document.documentElement.dataset.palette = saved.name;
        } catch {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader currentPath={Astro.url.pathname} />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter currentPath={Astro.url.pathname} />
  </body>
</html>
